# ============================================================
# KKNT-KP_116 — Environment Variables Template
# ============================================================
# Salin file ini menjadi `.env.local` untuk development lokal,
# atau set sebagai environment variables di Vercel untuk produksi.
#
#   cp .env.example .env.local
#
# PENTING KEAMANAN:
#   - JANGAN commit `.env`, `.env.local`, atau nilai secret apa pun.
#   - Semua file `.env*` sudah di-gitignore.
#   - Nilai FIREBASE_PRIVATE_KEY & FIREBASE_CLIENT_EMAIL adalah SECRET.
#     Simpan di Vercel → Settings → Environment Variables, atau
#     GitHub Actions → Secrets. Jangan pernah di source code.
# ============================================================

# ------------------------------------------------------------
# FIREBASE — Client SDK (NEXT_PUBLIC_ = dikirim ke browser, aman)
# Sumber: Firebase Console → Project settings → General → Web app
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=desa-sehat-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ------------------------------------------------------------
# FIREBASE — Admin SDK (SERVER-ONLY, SECRET — jangan expose ke browser)
# Sumber: Firebase Console → Project settings → Service accounts →
#         Generate new private key (JSON)
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=desa-sehat-2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key penuh (termasuk \n). Di .env.local, pakai quotes ganda:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# FIREBASE EMULATOR (khusus development lokal — opsional)
# Aktifkan emulator untuk test tanpa menyentuh produksi:
#   firebase emulators:start --only firestore,auth
# ------------------------------------------------------------
NEXT_PUBLIC_USE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8090
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ------------------------------------------------------------
# CORS (opsional — default hanya localhost:3000)
# ------------------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ------------------------------------------------------------
# VERCEL (otomatis diset oleh Vercel — tidak perlu diisi manual)
# ------------------------------------------------------------
# NEXT_PUBLIC_VERCEL_ENV=production
# VERCEL=1
